local teamCheck = false
local fov = 200
local smoothing = 1

-- Переменные для обучения
local totalShots = 0
local totalHits = 0
local accuracy = 0.0

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local FOVring = Drawing.new("Circle")
FOVring.Visible = true
FOVring.Thickness = 1.5
FOVring.Radius = fov
FOVring.Transparency = 1
FOVring.Color = Color3.fromRGB(255, 128, 128)
FOVring.Position = workspace.CurrentCamera.ViewportSize / 2

-- Получение ближайшего врага + нужная часть тела
local function getClosest(cframe, aimPart)
    local ray = Ray.new(cframe.Position, cframe.LookVector).Unit
    local target = nil
    local mag = math.huge
    local targetPart = nil

    for i, v in pairs(game.Players:GetPlayers()) do
        if v.Character and v.Character:FindFirstChild("Humanoid") and v.Character:FindFirstChild("HumanoidRootPart") and v ~= game.Players.LocalPlayer and (v.Team ~= game.Players.LocalPlayer.Team or (not teamCheck)) then
            
            local part = nil
            if aimPart == "Head" then
                part = v.Character:FindFirstChild("Head")
            else -- Body
                part = v.Character:FindFirstChild("UpperTorso") or v.Character:FindFirstChild("Torso") or v.Character:FindFirstChild("HumanoidRootPart")
            end

            if part then
                local magBuf = (part.Position - ray:ClosestPoint(part.Position)).Magnitude
                if magBuf < mag then
                    mag = magBuf
                    target = v
                    targetPart = part
                end
            end
        end
    end

    return target, targetPart
end

-- Самообучение
local function updateLearning(success)
    totalShots = totalShots + 1
    if success then totalHits = totalHits + 1 end
    accuracy = totalHits / totalShots

    if accuracy < 0.3 then
        fov = fov + 10
        smoothing = math.max(0.05, smoothing - 0.01)
    elseif accuracy > 0.7 then
        smoothing = math.min(1, smoothing + 0.01)
    end
    FOVring.Radius = fov
end

-- Основной аимбот: Alt = Head, E = Body
RunService.RenderStepped:Connect(function()
    local isAltPressed = UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt)
    local isEPressed = UserInputService:IsKeyDown(Enum.KeyCode.E)

    if not (isAltPressed or isEPressed) then return end

    local aimPart = isAltPressed and "Head" or "Body"  -- Alt имеет приоритет

    local cam = workspace.CurrentCamera
    local screenCenter = cam.ViewportSize / 2
    local closestTarget, targetPart = getClosest(cam.CFrame, aimPart)

    if closestTarget and targetPart then
        local screenPoint = cam:WorldToScreenPoint(targetPart.Position)
        local screenVec = Vector2.new(screenPoint.X, screenPoint.Y)

        if (screenVec - screenCenter).Magnitude < fov then
            local targetCFrame = CFrame.new(cam.CFrame.Position, targetPart.Position)
            cam.CFrame = cam.CFrame:Lerp(targetCFrame, smoothing)

            local hitChance = math.random() < 0.9
            updateLearning(hitChance)
        end
    end
end)

-- Статистика в консоль
RunService.RenderStepped:Connect(function()
    print(string.format("Accuracy: %.2f%% | Shots: %d | Hits: %d | FOV: %d", accuracy * 100, totalShots, totalHits, fov))
end)

-- ТВОЙ ОРИГИНАЛЬНЫЙ ESP (БЕЗ ИЗМЕНЕНИЙ)
local Players = game:GetService("Players")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local espElements = {}

local function createESP(player)
    if player == LocalPlayer then return end
    local espTable = {}
    local nameTag = Drawing.new("Text")
    nameTag.Visible = false
    nameTag.Center = true
    nameTag.Outline = true
    nameTag.Size = 18
    nameTag.Color = Color3.fromRGB(255, 255, 0)
    nameTag.Text = player.Name
    espTable.nameTag = nameTag

    local lines = {}
    for i = 1, 8 do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Thickness = 2
        line.Transparency = 1
        line.Color = Color3.fromRGB(255, 255, 0)
        table.insert(lines, line)
    end
    espTable.lines = lines
    espElements[player] = espTable
end

local function updateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local character = player.Character
            local root = character.HumanoidRootPart
            local head = character:FindFirstChild("Head")
            local lines = espElements[player] and espElements[player].lines
            local nameTag = espElements[player] and espElements[player].nameTag

            if head and root and lines then
                local rootPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))

                if onScreen then
                    nameTag.Position = Vector2.new(headPos.X, headPos.Y - 30)
                    nameTag.Visible = true

                    local points = {
                        Camera:WorldToViewportPoint(root.Position + Vector3.new(-1, 2, 0)),
                        Camera:WorldToViewportPoint(root.Position + Vector3.new(1, 2, 0)),
                        Camera:WorldToViewportPoint(root.Position + Vector3.new(-1, -2, 0)),
                        Camera:WorldToViewportPoint(root.Position + Vector3.new(1, -2, 0)),
                    }

                    lines[1].From = Vector2.new(points[1].X, points[1].Y); lines[1].To = Vector2.new(points[2].X, points[2].Y); lines[1].Visible = true
                    lines[2].From = Vector2.new(points[2].X, points[2].Y); lines[2].To = Vector2.new(points[4].X, points[4].Y); lines[2].Visible = true
                    lines[3].From = Vector2.new(points[4].X, points[4].Y); lines[3].To = Vector2.new(points[3].X, points[3].Y); lines[3].Visible = true
                    lines[4].From = Vector2.new(points[3].X, points[3].Y); lines[4].To = Vector2.new(points[1].X, points[1].Y); lines[4].Visible = true
                else
                    for _, line in pairs(lines) do line.Visible = false end
                    if nameTag then nameTag.Visible = false end
                end
            end
        end
    end
end

for _, player in pairs(Players:GetPlayers()) do createESP(player) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(function(player)
    if espElements[player] then
        for _, line in pairs(espElements[player].lines) do line:Remove() end
        espElements[player].nameTag:Remove()
        espElements[player] = nil
    end
end)

RunService.RenderStepped:Connect(updateESP)
